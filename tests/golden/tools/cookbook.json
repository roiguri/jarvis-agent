                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "who the recipe is from, and where"
              },
              "category": {
                "description": "a category id (find_recipes shows the ids)",
                "type": "string"
              },
              "comments": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
