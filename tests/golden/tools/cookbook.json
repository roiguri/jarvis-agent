                                    "type": "null"
                                  }
                                ],
                                "default": null,
                                "description": "a number or a fraction: 2, 0.5, 1/2, 1½. For a range (2–3), choose one number. None when there is no amount",
                                "title": "Amount"
                              },
                              "item": {
                                "description": "the ingredient",
                                "title": "Item",
                                "type": "string"
                              },
                              "unit": {
                                "anyOf": [
                                  {
                                    "type": "string"
