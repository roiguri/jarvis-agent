[
  {
    "destructive": false,
    "name": "find_recipes",
    "schema": {
      "description": "Find recipes in the family cookbook: the owner's own (default), or the\n    published ones. Each result has its id; get_recipe shows one in full.\n\n    Args:\n        query: part of the recipe's name, any language (names are mostly Hebrew).\n            Empty lists the newest.\n        mine: True = the owner's own recipes; False = the published ones.\n        category: optional category id (results show the ids in use).\n        stage: own recipes only: \"to-try\" or \"tested\".",
      "name": "find_recipes",
      "parameters": {
        "properties": {
          "category": {
            "default": "",
            "type": "string"
          },
          "mine": {
            "default": true,
            "type": "boolean"
          },
          "query": {
            "default": "",
            "type": "string"
          },
          "stage": {
            "default": "",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "scopes": null
  },
  {
    "destructive": false,
    "name": "get_recipe",
    "schema": {
      "description": "Show one cookbook recipe in full: ingredients, steps, times, notes and its\n    photos' links.\n\n    Args:\n        recipe_id: the recipe's id, as find_recipes shows it.",
      "name": "get_recipe",
      "parameters": {
        "properties": {
          "recipe_id": {
            "type": "string"
          }
        },
        "required": [
          "recipe_id"
        ],
        "type": "object"
      }
    },
    "scopes": null
  },
  {
    "destructive": false,
    "name": "save_recipe",
    "schema": {
      "description": "Save a recipe to the family cookbook, after the owner agreed on it in chat. The\n    owner gets a final Confirm / Cancel; nothing is saved before that. Saved recipes\n    are private. Saving the same source again changes nothing.\n\n    Args:\n        recipe: the whole recipe, in Hebrew.\n        source: where it came from: the link, or the file ids it was read from.\n            Keeps the same recipe from being saved twice.\n        estimated: the fields you estimated because the source didn't say (of\n            prepTime, waitTime, servings, servingsUnit, difficulty); the recipe\n            gets a note naming them.\n        stage: \"to-try\", or \"tested\" if the owner has made it.\n        submit: True only if the owner asked to send it for approval.\n        photo_file_ids: stored photos, the main one first (at most 5).\n        step_media: stored photos or videos shown with the steps, in order, each\n            with an optional caption.",
      "name": "save_recipe",
      "parameters": {
        "properties": {
          "estimated": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
